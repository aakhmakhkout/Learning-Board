{
  "meta": {
    "name": "Kaneki",
    "title": "Full Stack Journey",
    "tagline": "From HTML to a deployed MERN app in about 16 weeks, with a daily DSA habit. One page, every date.",
    "startDate": "2026-11-16",
    "hoursPerDay": 4
  },
  "phases": [
    {
      "name": "Web foundations",
      "color": "#d9432a",
      "goal": "Be comfortable with HTML, CSS and modern JavaScript.",
      "deliverable": "A responsive personal landing page, live on GitHub Pages",
      "tip": "Type every example by hand. Pasting teaches nothing.",
      "resources": [
        "Web basics"
      ],
      "tasks": [
        {
          "title": "HTML structure, forms, semantic tags",
          "days": 3
        },
        {
          "title": "CSS: box model, flexbox, grid",
          "days": 4
        },
        {
          "title": "Responsive layouts and Tailwind basics",
          "days": 3
        },
        {
          "title": "JavaScript: types, functions, arrays, objects",
          "days": 5
        },
        {
          "title": "DOM, events, fetch and async/await",
          "days": 4
        },
        {
          "title": "Mini project: weather app using a public API",
          "days": 3
        }
      ]
    },
    {
      "name": "React",
      "color": "#0f5a43",
      "goal": "Build interactive UIs with components, hooks and global state.",
      "deliverable": "Expense tracker deployed on Vercel",
      "tip": "Keep components small. If one needs a scroll bar, split it.",
      "resources": [
        "React"
      ],
      "tasks": [
        {
          "title": "Components, props, state",
          "days": 4
        },
        {
          "title": "Hooks: useEffect, useRef, custom hooks",
          "days": 4
        },
        {
          "title": "Routing and forms",
          "days": 3
        },
        {
          "title": "State management: Context and Redux Toolkit",
          "days": 4
        },
        {
          "title": "PROJECT 1: expense tracker with Redux Toolkit",
          "days": 5
        }
      ]
    },
    {
      "name": "Node + Express, day by day",
      "color": "#ef8a2f",
      "goal": "Understand how a server works instead of copying routes.",
      "deliverable": "Notes API running locally, tested in Postman",
      "tip": "Rebuild each day's code from a blank file before moving on.",
      "resources": [
        "Node + Express"
      ],
      "tasks": [
        {
          "title": "Day 1: HTTP and Node basics",
          "days": 1,
          "details": [
            {
              "label": "Learn (40 min)",
              "items": [
                "What a server is and how requests flow",
                "Node runtime, modules and npm",
                "HTTP methods and status codes"
              ]
            },
            {
              "label": "Practice",
              "items": [
                "Run a script with node",
                "Draw browser to server to response",
                "Hit a public API from Postman"
              ]
            }
          ]
        },
        {
          "title": "Day 2: Express routing and middleware",
          "days": 1,
          "details": [
            {
              "label": "Learn (40 min)",
              "items": [
                "Routes, params and query strings",
                "req, res and next()",
                "Writing a logging middleware"
              ]
            },
            {
              "label": "Practice",
              "items": [
                "Build 4 routes for notes",
                "Add a middleware that checks a header"
              ]
            }
          ]
        },
        {
          "title": "Day 3: REST API design",
          "days": 1,
          "details": [
            {
              "label": "Learn (40 min)",
              "items": [
                "Resources, URLs and verbs",
                "Request bodies and JSON",
                "Folder structure: routes, controllers"
              ]
            },
            {
              "label": "Practice",
              "items": [
                "Split Day 2 into routes and controllers",
                "Test every endpoint in Postman"
              ]
            }
          ]
        },
        {
          "title": "Day 4: Errors and validation",
          "days": 1,
          "details": [
            {
              "label": "Learn (40 min)",
              "items": [
                "A central error-handling middleware",
                "Validating untrusted input",
                "Useful status codes for failures"
              ]
            },
            {
              "label": "Practice",
              "items": [
                "Reject bad input with a 400",
                "Return a 404 for unknown ids"
              ]
            }
          ]
        },
        {
          "title": "Day 5: Mini project, Notes API",
          "days": 1,
          "details": [
            {
              "label": "Build",
              "items": [
                "In-memory CRUD for notes",
                "Save to a JSON file",
                "README with the endpoints"
              ]
            },
            {
              "label": "Note",
              "text": "No tutorial for this one. Look things up in the docs only."
            }
          ]
        }
      ]
    },
    {
      "name": "MongoDB + auth",
      "color": "#5b6b46",
      "goal": "Store data properly and protect it with real login.",
      "deliverable": "Job Tracker API with auth, live on Render",
      "tip": "Never store plain passwords, never commit .env.",
      "resources": [
        "MongoDB",
        "Auth + security"
      ],
      "tasks": [
        {
          "title": "MongoDB concepts, Atlas, Mongoose schemas",
          "days": 3
        },
        {
          "title": "CRUD API with Mongoose",
          "days": 4
        },
        {
          "title": "Auth: bcrypt, JWT, cookies",
          "days": 4
        },
        {
          "title": "File uploads and security basics",
          "days": 2
        },
        {
          "title": "PROJECT 2: Job Tracker API with auth",
          "days": 6
        }
      ]
    },
    {
      "name": "Capstone + apply",
      "color": "#2f62c9",
      "goal": "Ship one polished full-stack app and start applying.",
      "deliverable": "Capstone live, with README and demo video",
      "tip": "Ship something small and finished before adding features.",
      "resources": [
        "Deploy"
      ],
      "tasks": [
        {
          "title": "Capstone plan: schema, routes, wireframes",
          "days": 2
        },
        {
          "title": "Capstone backend",
          "days": 7
        },
        {
          "title": "Capstone frontend and integration",
          "days": 7
        },
        {
          "title": "Deploy: Vercel, Render, Atlas",
          "days": 2
        },
        {
          "title": "README, demo video, resume and LinkedIn update",
          "days": 3
        },
        {
          "title": "Apply daily: 10+ applications, 2 mock interviews",
          "days": 5
        }
      ]
    }
  ],
  "parallel": {
    "tag": "DSA",
    "name": "DSA in JavaScript",
    "intro": "45 minutes every evening. Patterns over volume.",
    "startDay": 14,
    "resources": [
      "DSA"
    ],
    "details": [
      {
        "label": "Block",
        "text": "Evening, 45 min, JavaScript"
      },
      {
        "label": "Rule",
        "text": "Understand the pattern, then solve 2 or 3 problems. Do not grind."
      }
    ],
    "items": [
      {
        "title": "Arrays, strings, hashmaps",
        "days": 7
      },
      {
        "title": "Two pointers, sliding window, prefix sums",
        "days": 14
      },
      {
        "title": "Stack, queue, binary search",
        "days": 14
      },
      {
        "title": "Recursion, linked lists, trees",
        "days": 14
      }
    ]
  },
  "projects": [
    {
      "title": "Project 1 · Expense tracker",
      "text": "React + Redux Toolkit, charts and filters."
    },
    {
      "title": "Project 2 · Job Tracker API",
      "text": "Express + MongoDB with auth and protected routes."
    },
    {
      "title": "Project 3 · Capstone",
      "text": "MERN app with real auth, docs and a demo video."
    }
  ],
