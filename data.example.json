  "notes": [
    {
      "title": "Daily rhythm",
      "text": "Morning: learn. Afternoon: build. Evening: 45 min DSA. Last 30 min: notes."
    },
    {
      "title": "Build first",
      "text": "One video or doc per topic, then build. No tutorial hopping."
    },
    {
      "title": "Git habit",
      "text": "Commit daily. Your GitHub graph is part of the resume."
    },
    {
      "title": "Sunday review",
      "text": "Tick progress. List 3 things you did not get. Fix those first."
    },
    {
      "title": "Cut rule",
      "text": "Phase over by 3 days? Cut scope, never push the next phase."
    },
    {
      "title": "Buffer",
      "text": "Sunday evening is free. Catch up, do not start new topics."
    }
  ]
